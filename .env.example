# Supabase PostgreSQL & Storage Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only Elevated Key for Backend Mutations (Never expose to browser)
# Found in: Supabase Dashboard -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Cloudinary Direct Image Upload Configuration (Optional, Supabase Storage can also be used)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Administrator Authentication Secrets
# ADMIN_PASSCODE: Master fallback administrator passcode
ADMIN_PASSCODE=soumya!nSUPA09
# ADMIN_AUTH_SECRET: Secret key used to sign HMAC-SHA256 session JWTs
ADMIN_AUTH_SECRET=leafora_super_secure_admin_jwt_secret_2026

# Shiprocket Checkout — Custom Integration Secret Key
# Set this to the secret key provided in your Shiprocket Checkout dashboard
# (Settings ? Integrations ? Custom Integration).
# Shiprocket will send this as: Authorization: Bearer <value>
SHIPROCKET_CHECKOUT_SECRET_KEY=your_shiprocket_checkout_secret_key_here
